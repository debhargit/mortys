{
  "name": "fox-and-d",
  "version": "1.0.0",
  "private": true,
  "description": "Meltha Honda Sales & Servs — static site + Postgres-backed API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "init-db": "psql \"$DATABASE_URL\" -f schema.sql",
    "cf:dev": "wrangler pages dev public --d1 DB=meltahonda-db --compatibility-flags nodejs_compat",
    "cf:deploy": "wrangler pages deploy public",
    "cf:migrate:local": "wrangler d1 migrations apply meltahonda-db --local",
    "cf:migrate": "wrangler d1 migrations apply meltahonda-db"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "hono": "^4.12.31",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.12.0",
    "selfsigned": "^5.5.0",
    "stripe": "^16.10.0",
    "twilio": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
