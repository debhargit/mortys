# Morty's Auto Parts backend config
# Copy to .env and edit for your machine.

# === Postgres ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mortysautoparts

# === Session ===
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# === HTTP ===
PORT=3057
COOKIE_SECURE=false
PUBLIC_BASE_URL=https://mortysautoparts.com

# === Email (Nodemailer) ===
# Leave blank to log emails to console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Morty's Auto Parts <noreply@mortysautoparts.com>

# === Stripe (payments) ===
# Leave STRIPE_SECRET_KEY blank to disable online card payments —
# cash-on-pickup and bank-transfer keep working without it.
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# === Twilio (SMS) ===
# Leave blank to log SMS to the server console instead of sending.
# Get credentials at https://console.twilio.com — provision a phone number that
# can send SMS to Jamaica (+1 876-…) and put it in TWILIO_FROM in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+18005551234
