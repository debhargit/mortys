# Vision Auto Solutions backend config
# Copy to .env and edit for your machine.

# === Postgres ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionautosolutions

# === Session ===
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# === HTTP ===
PORT=3056
COOKIE_SECURE=false
PUBLIC_BASE_URL=https://visionautosolutions.com

# === Email (Nodemailer) ===
# Leave blank to log emails to console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vision Auto Solutions <noreply@visionautosolutions.com>

# === Stripe (payments) ===
# Leave STRIPE_SECRET_KEY blank to disable online card payments —
# cash-on-pickup and bank-transfer keep working without it.
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=

# === Twilio (SMS) ===
# Leave blank to log SMS to the server console instead of sending.
# Get credentials at https://console.twilio.com — provision a phone number that
# can send SMS to Jamaica (+1 876-…) and put it in TWILIO_FROM in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+18005551234

# === Training: reading lessons aloud (voice.js) ===
# Set one key and the 🔊 Listen button on a lesson uses that voice; with neither,
# the browser's own voice reads it and nothing is sent out. Only the lesson text
# goes to Google, and each part is made once and kept in data/voice-cache.
# Gemini: a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# Google Cloud Text-to-Speech: an API key with the Text-to-Speech API turned on.
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=en-US-Neural2-F
# gemini | google | browser (when both keys are set, or to turn them off).
# TRAINING_VOICE=
