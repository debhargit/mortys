# ============================================================================
#  Vision Auto Solutions — repository ignores
#
#  This folder is a full deployed install: bundled Node + PostgreSQL, npm
#  dependencies, the live database and per-machine config all sit alongside
#  the source. Only the source, deployment scripts and docs are tracked.
#  (app/.gitignore covers a few more app-internal paths.)
# ============================================================================

# ---- bundled runtime & prerequisites (200 MB+, re-fetched by the installers)
/runtime/
/prereq/
/vendor/

# ---- npm dependencies
node_modules/
app/node_modules/

# ---- live runtime state: bundled Postgres data dir, boot lock, logs, backups
/data/
*.log
app/srv.tmp
app/*.tmp
app/*.copy
app/server.js.copy

# ---- secrets & per-machine config (set via Admin → Setup, never committed)
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example
app/.dev.vars
app/db-config.json
app/server-config.json
app/machine-config.json
app/terminal-id.json
app/portable.json

# ---- uploaded media (customer/product photos live in the DB + object storage)
app/uploads/
!app/uploads/.gitkeep

# ---- built installers (reproducible from the .ps1 sources via Build-Installers.ps1)
/*.exe

# ---- editor / OS cruft
.~lock.*#
Thumbs.db
Desktop.ini
.DS_Store
.claude/
.wrangler/
/dist/
app/*.bak-*

# ---- legacy DOS/FoxPro exports consumed by app/tools/seed-legacy.mjs
# Business data, not source: INVDETAI.csv is 161 MB and INVOICE.csv 115 MB, both
# over GitHub's 100 MB hard limit, and together the five are ~390 MB that would
# sit in history forever. Drop them in the repo root (or point the seeder at
# them with --dir) and run the seeder; nothing reads them at runtime.
/INVDETAI.csv
/INVOICE.csv
/INVPAY.csv
/INVREC.csv

# ---- legacy system's scratch directory (8 GB of .TMP spool files)
/WORK/
config-backups/

# ---- old homepage copies that must not sit in the served directory
app/public/*.bak-*
/.bak-public-homepages/

# ---- deploy scratch (a dated copy of functions/ and tools/ before a port)
app/deploy-backup-*/

# Protect-Vision-Database.ps1 marker (per machine)
/protected.json

# ---- live/development split (Separate Live From Development.bat)
/_separate-backup/
/live-location.txt
/data-dev-*/
